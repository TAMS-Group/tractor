#!/usr/bin/env python

import time
import tractor as tr
import tractor.types_double as tt
import math

b = tt.Vector3(1,2,3)

def f():
    global a
    a = tt.Vector3(2,3,4)
    tt.variable(a)
    tt.variable(b)
    #tt.goal(a * tt.Scalar(0.01) + 0.01)
    tt.goal(a * tt.Scalar(0.1))
    tt.goal(b * tt.Scalar(0.1))
    #tt.goal(tr.tanh(a) + tr.tanh(b) - tt.Scalar(0.1))
    tt.goal(a - tt.Scalar(0.1))

#f()
#print a
#print b

prog = tr.record(f)

print prog.constants
print prog.inputs
print prog.instructions
print prog.outputs

solver = tt.LeastSquaresSolver(tr.DefaultEngine())
#solver = tt.GradientDescentSolver(tr.DefaultEngine())

solver.compile(prog)

#solver.timeout = 1
solver.tolerance = 1e-12
solver.regularization = 0.01

print a.value, b.value

solver.solve()

print a.value, b.value, math.tanh(a.value) + math.tanh(b.value) - 0.1

