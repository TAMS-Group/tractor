#!/usr/bin/env python

import time
import tractor as tr
import tractor.types_double as tt
import math
import copy

#print tt.Tensor([1,2,3,4,5,6,7]).value

# ta = tt.Tensor([[1,2],[3,4]])
# tb = tt.Tensor([[1,2],[3,4]])

#tx = tt.Tensor([[1,2],[3,4]])

ta = tt.Tensor([[1,2],[3,123]])
print "init ta.value", ta.value

#tx = tt.Tensor([[1,2],[3,4]])
#tb = tt.Tensor([[1,2],[3,4]])



def f():
    global tx

    print "bla"

    tr.input(ta)

    tb = tt.Tensor([[1,2],[3,99]])

    #tb = tt.Tensor([[1,2],[3,99]])

    #tr.goal(tr.add(ta, tb))

    tx = tr.add(ta, tb)
    tr.output(tx)

prog = tr.record(f)


print prog.constants
print prog.inputs
print prog.instructions
print prog.outputs

engine = tr.DefaultEngine()
memory = engine.createMemory()
executable = engine.compile(prog)
print ""

print "ta.value", ta.value
print "tx.value", tx.value
print ""

ta.value = [[4,5],[6,7]]
executable.run(memory)
print "tx.value", tx.value
print ""

ta.value = [[1,2],[3,4]]
executable.run(memory)
print "tx.value", tx.value
print ""



