#!/usr/bin/env python

import time
import tractor as tr
import tractor.types_double as tt

a = tt.Scalar(3)

def f():
    global x, b
    b = tt.Scalar(2)
    tr.variable(a)
    tr.variable(b)
    x = tr.mul(a, b) + tt.Scalar(0.3)
    x += tt.Scalar(0.2)
    tr.output(x + x + x)

prog = tr.record(f)

print ""
print prog
print ""

derivatives = tr.derive(prog)

print ""
print "prepare"
print derivatives.prepare
print ""

print ""
print "forward"
print derivatives.forward
print ""

print ""
print "reverse"
print derivatives.reverse
print ""

engine = tr.DefaultEngine()
memory = engine.createMemory()
executable = engine.compile(prog)

print x.value

a.value = 2
b.value = 7
executable.run(memory)
print x.value

a.value = 1
b.value = 7
executable.run(memory)
print x.value
