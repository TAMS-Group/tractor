#!/usr/bin/env python

import time
import math
import numpy as np
import importlib
import tractor as t
import tractor
import inspect
import tractor.types_double as tt

class Tests:

    def quat_residual(self, tg):

        angle = tt.Scalar()
        t.variable(angle)
        angle *= tt.Scalar(10)

        axis = t.normalized(tg.Vector3(1,6,-3))

        t.goal(t.residual(tg.Orientation.angle_axis(angle, axis)))

    def pose_twist_add(self, tg):

        angle = tt.Scalar()
        t.variable(angle)

        axis = tg.Vector3()
        t.variable(axis)

        quat = tg.Orientation.angle_axis(angle, axis)

        pos = tg.Vector3()
        t.variable(pos)

        pose = tg.Pose(pos, quat)

        twist_t = tg.Vector3([1,2,3])
        twist_r = tg.Vector3([2,3,4])
        t.variable(twist_t)
        t.variable(twist_r)

        twist = tg.Twist(twist_t, twist_r)

        w = tg.Vector3()
        t.variable(w)

        t.goal(t.inverse(pose + twist + twist) * w)

