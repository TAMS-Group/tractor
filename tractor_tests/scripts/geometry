class Tests:

    def twist_properties(self, tg):
        v = tg.Vector3()
        t.variable(v)
        x = tg.Twist(v, tg.Vector3.zero)
        t.goal(x)

    def vec3_unpack(self, tg):
        a = tg.Vector3()
        t.variable(a)
        data = t.unpack(a)
        for d in data:
            t.goal(d)

    def vec3_pack(self, tg):
        a = tt.Scalar()
        b = tt.Scalar()
        c = tt.Scalar()
        t.variable(a)
        t.variable(b)
        t.variable(c)
        t.goal(tg.Vector3(a, b, c))

    def vec3_cross(self, tg):
        a = tg.Vector3()
        b = tg.Vector3()
        t.variable(a)
        t.variable(b)
        t.goal(t.cross(a, b))

    def vec3_norms(self, tg):
       a = tg.Vector3()
       t.variable(a)
       t.goal(t.norm(a))
       t.goal(t.squaredNorm(a))
       t.goal(t.normalized(a))

    def vec3_dot(self, tg):
        a = tg.Vector3()
        b = tg.Vector3()
        t.variable(a)
        t.variable(b)
        t.goal(t.dot(a, b))

    def mat3(self, tg):
        vec = tg.Vector3()
        mat1 = tg.Matrix3()
        mat2 = tg.Matrix3()
        t.variable(vec)
        t.variable(mat1)
        t.variable(mat2)
        vec = (mat1 + mat2) * -vec
        t.goal(vec)

    def stuff(self, tg):
        vec = tg.Vector3()
        t.variable(vec)
        angle = tt.Scalar()
        t.variable(angle)
        pose = tg.Pose.angle_axis(angle, tg.Vector3(1,2,3) * tt.Scalar(1/math.sqrt(1*1+2*2+3*3)))
        angle = tt.Scalar()
        t.variable(angle)
        pose2 = tg.Pose.angle_axis(angle, tg.Vector3(1,0,0))
        for i in range(3):
            vec = pose * pose2 * t.inverse(pose * pose) * vec + vec
        angle = tt.Scalar()
        t.variable(angle)
        orientation = tg.Orientation.angle_axis(angle, tg.Vector3(1,2,3) * tt.Scalar(1/math.sqrt(1*1+2*2+3*3)))
        for i in range(2):
            vec = orientation * vec + vec
        t.goal(vec)

    # def random(self, tg):
    #     a = tt.Scalar()
    #     b = tt.Scalar()
    #     t.variable(a)
    #     t.variable(b)
    #     x = t.ops.add_random_normal(a, b)
    #     t.goal(x)

engine = tractor.DefaultEngine()

class Variant:

    def __init__(self, function, module):
        self.program = tractor.record(lambda: function(module))
        self.derivatives = tractor.derive(self.program)
        self.x_compute = engine.compile(self.program)
        self.x_prepare = engine.compile(self.derivatives.prepare)
        self.x_forward = engine.compile(self.derivatives.forward)
        self.x_reverse = engine.compile(self.derivatives.reverse)
        self.scalar_size = 8
        self.memory = engine.createMemory()

    def make_compute_input(self):
        return np.random.normal(size=self.x_compute.input_buffer_size/self.scalar_size) * 1

    def make_forward_input(self):
        return np.random.normal(size=self.x_forward.input_buffer_size/self.scalar_size) * 1

    def make_reverse_input(self):
        return np.random.normal(size=self.x_reverse.input_buffer_size/self.scalar_size) * 1

    def run_compute(self, input):
        self.x_compute.input(input, self.memory)
        self.x_compute.execute(self.memory)
        self.x_prepare.execute(self.memory)
        return np.frombuffer(self.x_compute.output(self.memory), dtype=np.double)

    def run_forward(self, input):
        self.x_forward.input(input, self.memory)
        self.x_forward.execute(self.memory)
        return np.frombuffer(self.x_forward.output(self.memory), dtype=np.double)

    def run_reverse(self, input):
        self.x_reverse.input(input, self.memory)
        self.x_reverse.execute(self.memory)
        return np.frombuffer(self.x_reverse.output(self.memory), dtype=np.double)

    def run(self, compute_input, forward_input, reverse_input):
        ret_compute = self.run_compute(compute_input)
        ret_forward = self.run_forward(forward_input)
        ret_reverse = self.run_reverse(reverse_input)
        return [
            ret_compute,
            ret_forward,
            ret_reverse,
            ]

class GradientTester:

    def __init__(self, modules):
        self.modules = modules
        self.modes = ["compute", "forward", "reverse"]

    def check_output(self, a, b):
        assert(len(a) == len(b))
        all_ok = True
        for imode in range(len(a)):
            print np.sqrt(np.mean(np.square(a[imode] - b[imode])))
            ok = np.allclose(a[imode], b[imode])
            #if imode == 0: ok = False
            #print (self.modes[imode].rjust(8)+":"+("\033[92m"+"OK   "+"\033[0m" if ok else "\033[1m"+"\033[91m"+"ERROR"+"\033[0m")),
            print (self.modes[imode]+":"+("\033[1m"+"\033[92m"+"OK"+"\033[0m" if ok else "\033[1m"+"\033[91m"+"ERROR"+"\033[0m").ljust(20,".")),
            all_ok = all_ok and ok
        return all_ok

    def check_outputs(self, outputs):
        all_ok = True
        for ivar in range(1, len(outputs)):
            all_ok = all_ok and self.check_output(outputs[0], outputs[ivar])
        return all_ok

    def test(self, function):
        print (function.__name__+"").ljust(20, "."),
        variants = [Variant(function, m) for m in self.modules]
        compute_input = variants[0].make_compute_input()
        forward_input = variants[0].make_forward_input()
        reverse_input = variants[0].make_reverse_input()
        outputs = [v.run(compute_input, forward_input, reverse_input) for v in variants]
        all_ok = self.check_outputs(outputs)
        print ""

        if not all_ok:
            print ""
            for imode in range(3):
                print " ", self.modes[imode]
                for o in outputs:
                    print "".join(["%.3f".rjust(7) % v for v in o[imode]])
                print ""

modules = [
    tractor.types_double_twist,
    tractor.types_double_scalar,
]

tester = GradientTester(modules)
for m in inspect.getmembers(Tests(), predicate=inspect.ismethod):
    tester.test(m[1])
