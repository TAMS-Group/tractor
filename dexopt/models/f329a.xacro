<?xml version="1.0"?>
<robot
    name="test"
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    xmlns:sensor="http://playerstage.sourceforge.net/gazebo/xmlschema/#sensor"
    xmlns:controller="http://playerstage.sourceforge.net/gazebo/xmlschema/#controller"
    xmlns:interface="http://playerstage.sourceforge.net/gazebo/xmlschema/#interface">

    <xacro:include filename="$(find dexopt)/models/simple_box.xacro"/>
    <xacro:include filename="$(find dexopt)/models/invisible_box.xacro"/>

    <xacro:include filename="$(find tams_f329_description)/urdf/tams_f329_with_left_motorhand.xacro"/>

    <xacro:invisible_box type="floating" name="object" parent="table_center" sx="0.06" sy="0.06" sz="0.06" mass="0.01">
        <origin xyz="0.03 -0.1 ${0.03+0.15}" rpy="0 0 0"/>
    </xacro:invisible_box>

    <link name="object_visual">
        <visual>
            <geometry>
                <mesh filename="package://dexopt/models/cube02.dae" scale="0.03 0.03 0.03"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0"/>
        </visual>
    </link>
    <joint name="object_visual_joint" type="fixed">
      <parent link="object" />
      <child link="object_visual" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <xacro:simple_box type="fixed" name="floor" parent="table_center" sx="0.3" sy="0.3" sz="0.1" mass="1">
        <origin xyz="0.03 -0.1 ${-0.05+0.15}" rpy="0 0 0"/>
    </xacro:simple_box>

</robot>
