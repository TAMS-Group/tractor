<?xml version="1.0"?>
<robot
    name="test"
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    xmlns:sensor="http://playerstage.sourceforge.net/gazebo/xmlschema/#sensor"
    xmlns:controller="http://playerstage.sourceforge.net/gazebo/xmlschema/#controller"
    xmlns:interface="http://playerstage.sourceforge.net/gazebo/xmlschema/#interface">

    <xacro:include filename="$(find dexopt)/models/simple_box.xacro"/>

    <link name="world"/>

    <xacro:simple_box name="object" parent="world" sx="0.1" sy="0.1" sz="0.1" mass="1" type="floating" color="1 0 0 1">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:simple_box>

    <xacro:simple_box name="object_2" parent="world" sx="0.3" sy="0.3" sz="0.3" mass="1" color="0 1 0 1">
      <origin xyz="-0.3 0 0" rpy="0 0 0"/>
    </xacro:simple_box>

    <xacro:simple_box name="object_3" parent="world" sx="0.1" sy="0.1" sz="0.1" mass="1" color="0 0 1 1">
      <origin xyz="0 0.3 0" rpy="0 0 0"/>
    </xacro:simple_box>


</robot>
